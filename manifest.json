{
  "manifest_version": 3,
  "name": "Rune Projects Hub",
  "version": "1.1.2",
  "description": "Acesso rápido ao ecossistema Rune Projects e tracker inteligente de animes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Rune Projects Hub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.runeprojects.com.br/*",
    "https://runehub.runeprojects.com.br/*",
    "https://runestorage.runeprojects.com.br/*",
    "https://runestorage.up.railway.app/*",
    "https://www.crunchyroll.com/*",
    "https://static.crunchyroll.com/*",
    "http://localhost:3005/*",
    "https://isekaitracker.runeprojects.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}

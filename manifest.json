{
  "manifest_version": 3,
  "name": "Isekai;Tracker",
  "version": "2.0.0",
  "description": "Acompanhe localmente o progresso de episódios da Crunchyroll no painel lateral.",
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "action": {"default_title":"Isekai;Tracker"},
  "side_panel": {"default_path":"sidepanel.html"},
  "background": {"service_worker":"background.js"},
  "permissions": ["sidePanel", "storage"],
  "content_scripts": [{"matches":["https://www.crunchyroll.com/*","https://static.crunchyroll.com/*"],"js":["content.js"],"all_frames":true,"run_at":"document_start"}]
}

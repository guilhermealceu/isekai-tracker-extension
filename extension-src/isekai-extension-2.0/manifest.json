{
  "manifest_version": 3,
  "name": "IsekaiTracker2.0 — Crunchyroll Scrobbler (MV3)",
  "version": "1.1.1",
  "description": "Coleta tempo assistido no Crunchyroll e envia para https://isekai-tracker.discloud.app (Isekai;TrackerWeb).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://static.crunchyroll.com/*",
    "http://localhost:3005/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [{
    "matches": [
      "https://www.crunchyroll.com/*",
      "https://static.crunchyroll.com/*"
    ],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_start"
  }],
  "action": {
    "default_title": "Isekai;Tracker2.0",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
